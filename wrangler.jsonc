{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sigco-giac",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sigco-giac-db",
      "database_id": "4676fc0b-b6cb-4bc0-9ec5-3efb90fe2efa"
    }
  ]
}
